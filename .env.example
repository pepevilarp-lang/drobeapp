# ═══ Variables de entorno de Drobe (Vercel → Settings → Environment Variables) ═══
# Copia los nombres, no los valores. Este fichero NO se usa en producción:
# es solo documentación de qué espera el proyecto.

# IA — función serverless /api/ai. Reconoce prendas en fotos, lee tickets y
# alimenta al estilista. Consíguela en console.groq.com
GROQ_API_KEY=gsk_...

# Búsqueda de productos reales — función /api/shopping (Google Shopping).
# Opcional: sin ella, el asesor de compra cae a sugerencias de la IA.
# 100 búsquedas/mes gratis en serpapi.com
SERPAPI_KEY=

# Strava — función /api/strava. Opcional: sincroniza los km reales de
# zapatillas y bicis. Crea la app en https://www.strava.com/settings/api
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# ─────────────────────────────────────────────────────────────────────
# Supabase NO va aquí.
# SUPABASE_URL y SUPABASE_ANON_KEY están escritas directamente en
# lib/supabase.js porque tienen que llegar al navegador. La anon key es
# pública por diseño: quien protege los datos es RLS (supabase/schema.sql),
# no el secreto de la clave.
# ─────────────────────────────────────────────────────────────────────
